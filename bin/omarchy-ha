#!/usr/bin/env python3
r"""omarchy-ha — Home Assistant CLI launcher backed by the bar controller.

Usage:
  omarchy-ha state list '^light\.'
  omarchy-ha area list
  omarchy-ha service call light.turn_on --arguments entity_id=light.example

The controller owns the session: this launcher sends only the argument
vector over a private Unix socket; the controller injects HASS_SERVER and a
current HASS_TOKEN into the hass-cli child environment. The token never
appears in this process's arguments, output, or environment.

Credential/debug options are rejected controller-side; this wrapper only
relays the vetted surface.
"""

import json
import os
import socket
import sys

SOCKET_PATH = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", ""), "omarchy-ha", "controller.sock"
)


def fail(message: str, code: int = 1) -> None:
    print(f"omarchy-ha: {message}", file=sys.stderr)
    sys.exit(code)


def main() -> int:
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return 2

    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(90)
        sock.connect(SOCKET_PATH)
    except (OSError, ConnectionRefusedError):
        fail("controller not reachable — is omarchy-home-assistant.service running?")

    f = sock.makefile("r")
    try:
        first = f.readline()  # snapshot push
    except (socket.timeout, OSError):
        fail("controller did not answer")
    if not first:
        fail("controller closed the connection")

    request = {"cmd": "cli.exec", "args": args, "id": 1}
    sock.sendall((json.dumps(request) + "\n").encode())

    while True:
        try:
            line = f.readline()
        except (socket.timeout, OSError):
            fail("timed out talking to the controller")
        if not line:
            fail("controller closed the connection")
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        if msg.get("type") == "reply" and msg.get("id") == 1:
            break
        # status/update pushes are ignored by the launcher

    if not msg.get("ok"):
        fail(str(msg.get("error") or "command rejected"))

    if msg.get("stdout"):
        sys.stdout.write(msg["stdout"])
        sys.stdout.flush()
    if msg.get("stderr"):
        sys.stderr.write(msg["stderr"])
    return int(msg.get("code") or 0)


if __name__ == "__main__":
    sys.exit(main())
